    "@qortexone-jenkins/jenkins-common": "https://github.com/qburst-musharraf/qortexone-jenkins#release-backend",
    "@types/express": "^4.17.6",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.0",
    "node-fetch": "^2.6.7",
    "yn": "^4.0.0"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.10.4",

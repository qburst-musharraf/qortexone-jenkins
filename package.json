{
  "name": "@qortexone/plugin-jenkins-backend",
  "version": "0.24.1",
  "description": "A Backstage backend plugin that integrates towards QortexOne IDP Jenkins",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "jenkins",
    "pluginPackages": [
      "@qortexone/plugin-jenkins",
      "@qortexone/plugin-jenkins-backend",
      "@qortexone/plugin-jenkins-common"
    ]
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qburst-musharraf/qortexone-jenkins",
    "directory": "workspaces/jenkins/plugins/jenkins-backend"
  },
  "license": "Apache-2.0",
  "main": "dist/index.cjs.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.d.ts"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
